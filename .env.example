# DukaanBot Environment Variables Template
# Copy this file to .env and configure your keys

# AI / LLM Configuration (Supports Groq, OpenAI, or Gemini OpenAI-compatible endpoints)
# Groq Free Tier (ultra-fast, recommended): https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=your_openai_or_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# JWT Secret Key for Shopkeeper Authentication
JWT_SECRET=dukaanbot_jwt_secret_key_super_secure_2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=72

# Shop & Retrieval Defaults
DATABASE_FILE=dukaanbot.db
CONFIDENCE_THRESHOLD=0.40
DEFAULT_SHOP_ID=shop_kirana_01

# Optional WhatsApp Webhook / Twilio Integration
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
